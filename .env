# CONFIGURATION DU SERVEUR
PORT=5000
NODE_ENV=développement
FRONTEND_URL=http://localhost:3000
JWT_SECRET=votre_secret_jwt_tres_long_et_securise

# BASE DE DONNÉES
DATABASE_URL=mongodb://localhost:27017/ungriff_db

# API IMPRIMÉE (UNICATION DU SERVEUR)
CLÉ_API_IMPRIMÉE=
ID_MAGASIN_IMPRIMÉ=

# CONFIGURATION PAYPAL (UNIQUEMENT DU SERVEUR)
PAYPAL_MODE=sandbox # Passeur à 'live' en production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AUTHENTIFICATION GOOGLE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
