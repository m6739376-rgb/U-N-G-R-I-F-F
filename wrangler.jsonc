{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ungriff-store",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/stats", "/track"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ungriff-store-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ADMIN_EMAIL": "m6739376@gmail.com",
    "STORE_CURRENCY": "eur"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
